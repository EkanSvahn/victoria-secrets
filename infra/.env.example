# Production environment for infra/docker-compose.prod.yml.
#
# Copy to infra/.env on the deployment host and customize.
# infra/.env is gitignored — never commit deployment-specific values.

# REQUIRED. No safe default; the compose file fails fast if unset.
# Use the public HTTPS origin you serve from. Comma-separate multiple values.
ALLOWED_ORIGINS=https://your-domain.example.com

# --- Backend payload size limits (bytes) ---
# Defaults assume ~80 MiB ciphertext (covers ~50 MiB raw file + AES-GCM overhead).
# To raise the file limit: increase all four together so that
#   MAX_BODY_BYTES > MAX_CIPHERTEXT_BYTES + MAX_META_BYTES + ~1024.
MAX_BODY_BYTES=94371840
MAX_META_BYTES=16384
MAX_CIPHERTEXT_BYTES=83886080
MAX_FILE_BYTES=52428800

# MIME allowlist. Each type must be exact-match.
ALLOWED_FILE_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/octet-stream

# --- Lifetime / view limits ---
MAX_TTL_SECONDS=86400
MAX_VIEWS=100
ID_LENGTH_BYTES=24

# 60s minimum for large file uploads with Argon2id key derivation.
# Setting this below ~30s will time out password-mode encrypts on slower clients.
REQUEST_TIMEOUT_MS=60000

# --- Per-IP rate limits ---
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# --- Security policy ---
# REQUIRE_PASSWORD=true rejects link-fragment-key shares; only password-derived
# keys are accepted. Recommended for organization/internal deployments.
# Frontend mirror (VITE_REQUIRE_PASSWORD) must match.
REQUIRE_PASSWORD=true
VITE_REQUIRE_PASSWORD=true

# Fails startup if Redis has persistence enabled (appendonly or RDB save).
STRICT_REDIS_EPHEMERAL=true
