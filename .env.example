# Backend
LISTEN_ADDR=:8080
REDIS_URL=redis://redis:6379/0
MAX_BODY_BYTES=367001600
MAX_META_BYTES=16384
MAX_CIPHERTEXT_BYTES=314572800
MAX_FILE_BYTES=262144000
ALLOWED_FILE_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/octet-stream,application/json,application/zip,application/x-rar-compressed,application/vnd.rar,application/x-7z-compressed,application/gzip,application/x-tar
MAX_TTL_SECONDS=86400
MAX_VIEWS=100
ID_LENGTH_BYTES=24
REQUEST_TIMEOUT_MS=5000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDR=
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20
METRICS_ENABLED=false
REQUIRE_PASSWORD=false
STRICT_REDIS_EPHEMERAL=true

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_REQUIRE_PASSWORD=false
VITE_CODE_URL=https://github.com/your-org/your-repo
